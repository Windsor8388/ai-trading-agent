# Server-side configuration template — NOT a browser .env file.
# Store actual BINGX_API_KEY, BINGX_SECRET_KEY, and GEMINI_API_KEY in your
# Secret Manager. Do not replace any reference below with an actual key.

# Secret references resolved only in a trusted backend process.
BINGX_API_KEY_REF=sm://env/BINGX_API_KEY
BINGX_API_SECRET_REF=sm://env/BINGX_SECRET_KEY
# GEMINI_API_KEY_REF=sm://env/GEMINI_API_KEY

# BingX starts in the official simulated environment. No code in this release
# dispatches a production-live order.
BINGX_ENVIRONMENT=prod-vst
BINGX_READ_ONLY_VERIFIED=false
BINGX_VENUE_CONTRACT_JSON={"documentation_url":"https://github.com/BingX-API/api-ai-skills","documentation_version":"commit-5d96e72561c97de2ec3ba8650e48582c371cd4ad","api_base_url":"https://open-api-vst.bingx.com","market_data_adapter_version":"0.1.0","execution_adapter_version":"0.1.0","account_scope":"USDT-M_PERPETUAL","client_order_id_supported":true,"order_status_reconciliation_supported":true,"cancel_supported":true,"websocket_recovery_supported":true}

# Keep disabled until the Gemini secret is bound and a reviewed model is selected.
# To enable advisory chart commentary only, set both values below in backend config:
GEMINI_ROLE=DISABLED
# GEMINI_ROLE=ADVISORY_ONLY
# GEMINI_MODEL_ID=your-reviewed-gemini-model-id
